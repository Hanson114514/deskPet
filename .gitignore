# 用户数据（配置、日志、用户自备素材包）——不随仓库分发
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
.venv/
venv/
env/

# 打包产物
build/
dist/
*.spec
# …但 `deskpet.spec` 是**手工维护的交付物**（不是 PyInstaller 自动生成的），
# 要进版本控制：它是分发包的唯一构建配方（§6）。
!deskpet.spec

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# 工作过程文件（只留在本地 main 上，不进开源仓库）
agent.md
requests.md
tasks/

# 素材源与第三方参考工程
# `assets/` 里已经是抽好帧的成品；`raw/` 只是构建期的输入，不进开源仓库。
raw/

# 与"主体功能测试"无关的工具（开源仓库只保留 check_task*.py 与两个自启 .ps1）
#   extract_gif_frames / make_kv_package —— 素材处理，且依赖已被排除的 raw/
#   check_dist / check_dist_autostart    —— 测的是打包产物，不是源码功能
#   probe_task15_perf                    —— 性能探针（量耗时），不是功能断言
tools/extract_gif_frames.py
tools/make_kv_package.py
tools/check_dist.py
tools/check_dist_autostart.py
tools/probe_task15_perf.py
